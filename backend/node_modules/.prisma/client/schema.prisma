generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Department {
  HR
  IT
  FINANCE
  OPERATIONS
  SALES
  OTHER
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String     @id @default(uuid())
  fullName     String
  email        String     @unique
  department   Department
  passwordHash String
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("users")
}
